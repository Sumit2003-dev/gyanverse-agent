# GyanVerse Agent — environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# --- Model access (pick ONE) ---
# Option A (recommended, free tier, NO billing): Gemini API key.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key
# Routes the ADK + genai client to the Gemini API (not Vertex AI).
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# Option B (billing required): Vertex AI in your GCP project.
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Model ---
# lite variant = separate 20 req/day free quota from gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Retrieval embedding backend ---
# gemini (default, Google-native) | openai (pre-existing GyanVerse backend) | local
EMBED_BACKEND=gemini
# gemini-embedding-2 works on the Gemini API (free tier); 3072 dims.
EMBED_MODEL=gemini-embedding-2

# --- Pre-existing OpenAI backend (only used when EMBED_BACKEND=openai) ---
# OPENAI_API_KEY=sk-...

# --- Local Firestore emulator (optional, keeps costs at zero) ---
# Set FIRESTORE_EMULATOR=true to use the emulator on localhost:8080.
# Needs the gcloud CLI (see scripts/firestore_emulator.ps1), not a real project.
# When false and no Firestore is reachable, state falls back to .state/ JSON.
FIRESTORE_EMULATOR=false